# Copy this file to .env and fill in real (TEST MODE ONLY) values.
# Never commit .env or real keys/secrets.

# Razorpay test-mode credentials (prefix rzp_test_ for the key id). All optional -- unset,
# the system runs on synthetic data exactly as it does today.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=changeme
RAZORPAY_WEBHOOK_SECRET=changeme

# L2's single residual-triage call site (Phase 4) auto-detects whichever of these three is set
# (l2_llm_triage/factory.py). All optional: with none set, L2 falls back to the free rapidfuzz
# path, exactly as `make demo`/`make close` have always run. Set LLM_PROVIDER to force a specific
# one if more than one key is present -- otherwise Anthropic wins (every doc/pricing table in
# this repo was written against it), then OpenAI, then Gemini.
LLM_PROVIDER=
LLM_API_KEY=changeme          # Anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hard ceiling on LLM spend for a single run, enforced by the budget guard (Phase 4)
MAX_SPEND_USD=2.0

# Deterministic seed for data generation and any stochastic components
SEED=42

# L3 calibrated-confidence threshold above which a decision may AUTO_POST
# (Phase 5 derives the real value from the cost model; this is a placeholder default)
CONFIDENCE_THRESHOLD=0.94

# L5 authority policy: max amount (in paise) that may ever be auto-posted
AUTHORITY_LIMIT_PAISE=10000000

# Deployment only (api/app.py). Empty by default -- see that module's docstring.
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=
EXECUTE_API_KEY=
