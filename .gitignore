# Secrets
.env

# Databases
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Generated/raw data (never commit real Razorpay data or large generated datasets)
data/raw/
data/samples/residual.jsonl
data/samples/l2_results.jsonl

# make close's output (a fresh DB + audit log per run, not repo content)
/ledgerguard.db
/audit.jsonl

# NOTE: data/cache/ (L2's prompt-hash response cache) is deliberately NOT ignored -- plan.md
# #20 requires it to be committed so a benchmark rerun costs $0 and needs no API key.
# last_run_spend.json is ephemeral run state (read by /healthz), not a reproducibility
# artifact, so it's excluded even though its parent directory is committed.
data/cache/l2/last_run_spend.json

# Eval output (charts, ablation.json regenerated by make bench)
eval/output/*
!eval/output/.gitkeep

# report.html is regenerated by `python -m eval.report` from report.md's own numbers -- report.md
# itself IS committed (Phase 9's traceable "single committed make bench output" evidence).
/report.html

# OS / editor cruft
.DS_Store
*.swp
